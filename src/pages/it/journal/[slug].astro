---
import { getCollection } from 'astro:content';
import ArticlePage from '@/views/ArticlePage.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (a) => a.data.lang === 'it' && a.data.published);
  return articles.map((article) => ({ params: { slug: article.data.route }, props: { article } }));
}

const { article } = Astro.props;
---
<ArticlePage article={article} />
