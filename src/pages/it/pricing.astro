---
import BaseLayout from '@layouts/BaseLayout.astro';
import PricingContent from '@components/page-content/PricingContent.astro';
import { getEntry } from 'astro:content';

const lang = 'it' as 'en' | 'de' | 'it';
const page = await getEntry('pages', 'pricing');
const seo = page.data.seo;
const d = page.data as any;

const siteUrl = 'https://astiaweb.com';
const priceValidUntil = `${new Date().getFullYear() + 1}-12-31`;

const offerSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Self-Serve — Fino a 15 camere',
    description: d.matrix.selfTagline[lang],
    url: `${siteUrl}/it/pricing`,
    price: d.matrix.prices.selfSmall,
    priceCurrency: d.matrix.currency,
    billingIncrement: 1,
    priceValidUntil,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: d.matrix.prices.selfSmall,
      priceCurrency: d.matrix.currency,
      unitCode: 'MON',
      description: 'Abbonamento mensile',
    },
    itemOffered: {
      '@type': 'Service',
      name: 'Self-Serve',
      areaServed: 'Hotel and Accommodation',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Self-Serve — Fino a 30 camere',
    description: d.matrix.selfTagline[lang],
    url: `${siteUrl}/it/pricing`,
    price: d.matrix.prices.selfMedium,
    priceCurrency: d.matrix.currency,
    billingIncrement: 1,
    priceValidUntil,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: d.matrix.prices.selfMedium,
      priceCurrency: d.matrix.currency,
      unitCode: 'MON',
      description: 'Abbonamento mensile',
    },
    itemOffered: {
      '@type': 'Service',
      name: 'Self-Serve',
      areaServed: 'Hotel and Accommodation',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Self-Serve — 50+ camere',
    description: d.matrix.selfTagline[lang],
    url: `${siteUrl}/it/pricing`,
    price: d.matrix.prices.selfLarge,
    priceCurrency: d.matrix.currency,
    billingIncrement: 1,
    priceValidUntil,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: d.matrix.prices.selfLarge,
      priceCurrency: d.matrix.currency,
      unitCode: 'MON',
      description: 'Abbonamento mensile',
    },
    itemOffered: {
      '@type': 'Service',
      name: 'Self-Serve',
      areaServed: 'Hotel and Accommodation',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Managed — Fino a 15 camere',
    description: d.matrix.managedTagline[lang],
    url: `${siteUrl}/it/pricing`,
    price: d.matrix.prices.managedSmall,
    priceCurrency: d.matrix.currency,
    billingIncrement: 1,
    priceValidUntil,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: d.matrix.prices.managedSmall,
      priceCurrency: d.matrix.currency,
      unitCode: 'MON',
      description: 'Abbonamento mensile',
    },
    itemOffered: {
      '@type': 'Service',
      name: 'Managed',
      areaServed: 'Hotel and Accommodation',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Managed — Fino a 30 camere',
    description: d.matrix.managedTagline[lang],
    url: `${siteUrl}/it/pricing`,
    price: d.matrix.prices.managedMedium,
    priceCurrency: d.matrix.currency,
    billingIncrement: 1,
    priceValidUntil,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: d.matrix.prices.managedMedium,
      priceCurrency: d.matrix.currency,
      unitCode: 'MON',
      description: 'Abbonamento mensile',
    },
    itemOffered: {
      '@type': 'Service',
      name: 'Managed',
      areaServed: 'Hotel and Accommodation',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Offer',
    name: 'Managed — 50+ camere',
    description: d.matrix.managedTagline[lang],
    url: `${siteUrl}/it/pricing`,
    price: d.matrix.prices.managedLarge,
    priceCurrency: d.matrix.currency,
    billingIncrement: 1,
    priceValidUntil,
    priceSpecification: {
      '@type': 'PriceSpecification',
      price: d.matrix.prices.managedLarge,
      priceCurrency: d.matrix.currency,
      unitCode: 'MON',
      description: 'Abbonamento mensile',
    },
    itemOffered: {
      '@type': 'Service',
      name: 'Managed',
      areaServed: 'Hotel and Accommodation',
    },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.items.map((item: any) => ({
    '@type': 'Question',
    name: item.q[lang],
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a[lang],
    },
  })),
};
---
<BaseLayout lang={lang} page="pricing" seo={seo} currentPath="/it/pricing" schemas={[...offerSchemas, faqSchema]}>
  <PricingContent lang={lang} />
</BaseLayout>
