---
import BaseLayout from '@layouts/BaseLayout.astro';
import PortfolioCard from '@components/PortfolioCard.astro';
import { getCollection, getEntry } from 'astro:content';

const lang = 'en' as 'en' | 'de' | 'it';
const site = await getEntry('site', 'general');
const s = site.data as any;
const portfolio = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);

const seo = {
  title: { en: 'Showcase \u00b7 Astia Web \u2014 Sites Built on the Astia Stack', de: 'Showcase \u00b7 Astia Web', it: 'Showcase \u00b7 Astia Web' },
  description: { en: 'Explore websites built on the Astia stack. Fast, modern, and designed to convert. See what we can build for your property.', de: 'Websites, die auf dem Astia-Stack gebaut wurden.', it: 'Siti costruiti con lo stack Astia.' },
  ogImage: '/images/nature-led-experience-exploreans-retreat.jpg',
  ogImageAlt: { en: 'Astia Web showcase', de: 'Astia Web Showcase', it: 'Showcase Astia Web' },
};
---
<BaseLayout lang={lang} page="showcase" seo={seo} currentPath="/showcase">
  <section class="section hero-mesh" style="padding-top:140px; padding-bottom:60px;">
    <div class="container">
      <h1 class="display-1 fade-in delay-2" style="margin-top:0; max-width:900px;">
        Sites built on the <span class="editorial-i">Astia stack</span>
      </h1>
      <p class="lede fade-in delay-3" style="margin-top:24px; max-width:600px;">
        Fast, modern websites for hospitality brands. Each one loads in under a second, ranks higher on Google, and converts more direct bookings.
      </p>
      <div class="fade-in delay-4" style="margin-top:32px;">
        <span class="perf-badge">{portfolio.length} properties live \u00b7 new showcases added regularly</span>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {portfolio.map((p, i) => (
          <div class={`reveal reveal-delay-${(i % 3) + 1}`}>
            <PortfolioCard
              tag={p.data.tag[lang]}
              title={p.data.title}
              sub={p.data.subtitle[lang]}
              img={p.data.image}
              alt={p.data.imageAlt[lang]}
              url={p.data.url}
            />
          </div>
        ))}
        {/* CTA Card */}
        <div class="reveal reveal-delay-2">
          <a href="/apply" style="text-decoration:none; color:inherit;">
            <div class="portfolio-card" style="aspect-ratio:4/5; background:var(--ink); display:flex; flex-direction:column; justify-content:center; align-items:center; padding:40px; text-align:center; border:1px solid var(--ink); transition:all 0.3s;">
              <div style="font-family:'Editorial New',serif; font-style:italic; font-size:48px; color:var(--rosso); margin-bottom:20px;">+</div>
              <h3 style="font-family:'Editorial New',serif; font-size:28px; color:var(--paper); margin:0 0 12px; font-weight:400;">Your property</h3>
              <p style="font-size:14px; color:var(--stone-soft); margin:0 0 24px; line-height:1.5;">Join the showcase. Apply now and launch in 2\u20133 weeks.</p>
              <span class="btn btn-primary" style="background:var(--rosso); border-color:var(--rosso);">Apply \u2192</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <section class="section section-cream">
    <div class="container-narrow reveal" style="text-align:center;">
      <h2 class="display-2" style="margin-top:0; margin-bottom:20px;">
        Ready to <span class="editorial-i">showcase</span> your property?
      </h2>
      <p class="lede" style="margin-bottom:36px; max-width:520px; margin-left:auto; margin-right:auto;">
        Every site we build becomes part of this collection. Tell us about your property and we'll respond within three business days.
      </p>
      <a class="btn btn-primary btn-arrow" href="/apply">{s.cta.applyForSite[lang]}</a>
    </div>
  </section>
</BaseLayout>
