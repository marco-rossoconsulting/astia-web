---
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeContent from '@components/page-content/HomeContent.astro';
import { getEntry } from 'astro:content';

const lang = 'en' as 'en' | 'de' | 'it';
const page = await getEntry('pages', 'home');
const seo = page.data.seo;

const siteUrl = 'https://astiaweb.com';
const priceValidUntil = `${new Date().getFullYear() + 1}-12-31`;

const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Astia Web',
  url: siteUrl,
  logo: `${siteUrl}/images/marcorosso-consulting-logo.png`,
  description: seo.description[lang],
  provider: {
    '@type': 'Organization',
    name: 'Marcorosso Consulting',
    url: 'https://rossoconsulting.ch',
  },
  areaServed: {
    '@type': 'Industry',
    name: 'Hospitality and Small Business',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Astia Web Tiers',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Self-Serve — Up to 15 rooms',
          description: 'You edit, via Sveltia CMS. We host, secure, and refresh annually.',
        },
        price: '150',
        priceCurrency: 'CHF',
        billingIncrement: 1,
        priceValidUntil,
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Self-Serve — Up to 30 rooms',
          description: 'You edit, via Sveltia CMS. We host, secure, and refresh annually.',
        },
        price: '200',
        priceCurrency: 'CHF',
        billingIncrement: 1,
        priceValidUntil,
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Self-Serve — 50+ rooms',
          description: 'You edit, via Sveltia CMS. We host, secure, and refresh annually.',
        },
        price: '300',
        priceCurrency: 'CHF',
        billingIncrement: 1,
        priceValidUntil,
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Managed — Up to 15 rooms',
          description: 'You email. AI agents and we handle every edit, within 24 hours.',
        },
        price: '250',
        priceCurrency: 'CHF',
        billingIncrement: 1,
        priceValidUntil,
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Managed — Up to 30 rooms',
          description: 'You email. AI agents and we handle every edit, within 24 hours.',
        },
        price: '350',
        priceCurrency: 'CHF',
        billingIncrement: 1,
        priceValidUntil,
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Managed — 50+ rooms',
          description: 'You email. AI agents and we handle every edit, within 24 hours.',
        },
        price: '550',
        priceCurrency: 'CHF',
        billingIncrement: 1,
        priceValidUntil,
      },
    ],
  },
};
---
<BaseLayout lang={lang} page="home" seo={seo} currentPath="/" schemas={[professionalServiceSchema]}>
  <HomeContent lang={lang} />
</BaseLayout>
