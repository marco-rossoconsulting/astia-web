---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import FinalCta from '@components/FinalCta.astro';
import Icon from '@components/Icon.astro';
import { formatDate, href, type Lang } from '@/i18n';
import { pages } from '@/i18n/pages';
import { shared } from '@/i18n/shared';
import { articlePath, articlesFor, minutes } from '@/lib/articles';
import { breadcrumbSchema } from '@/lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = pages[lang].journal;
const s = shared[lang];
const path = href(lang, 'journal');
const articles = await articlesFor(lang);
const [latest, ...rest] = articles;
---
<BaseLayout
  lang={lang}
  title={t.seo.title}
  description={t.seo.description}
  path={path}
  nav="journal"
  schemas={[breadcrumbSchema([{ name: 'Astia Web', path: href(lang, 'home') }, { name: s.nav.journal, path }])]}
>
  <PageHero title={t.title} lede={t.lede} />

  <section class="section section--paper">
    <div class="container">
      {latest && (
        <a href={articlePath(latest)} class="feature reveal">
          <span class="mono-label feature-label">{t.latest}</span>
          <div class="feature-grid">
            <h2 class="feature-title">{latest.data.title}</h2>
            <div>
              <p class="feature-excerpt">{latest.data.excerpt}</p>
              <p class="meta mono">
                <span>{latest.data.tag}</span>
                <span>{formatDate(latest.data.date, lang)}</span>
                <span>{minutes(latest.data.readingTime)} {t.minRead}</span>
              </p>
              <span class="read">{s.common.readMore}<Icon name="arrow-right" size={16} /></span>
            </div>
          </div>
        </a>
      )}

      <ul class="list">
        {rest.map((a, i) => (
          <li class="reveal" style={`--d:${(i % 2) * 0.06}s`}>
            <a href={articlePath(a)} class="item">
              <p class="meta mono">
                <span>{a.data.tag}</span>
                <span>{formatDate(a.data.date, lang)}</span>
                <span>{minutes(a.data.readingTime)} {t.minRead}</span>
              </p>
              <h2 class="item-title">{a.data.title}</h2>
              <p class="item-excerpt">{a.data.excerpt}</p>
              <span class="read">{s.common.readMore}<Icon name="arrow-right" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCta lang={lang} title={t.endTitle} lede={t.endLede} surface="cream" />
</BaseLayout>

<style>
  .feature {
    display: block;
    padding: 0 0 56px;
    border-bottom: 1px solid var(--bone);
  }
  .feature-label { color: var(--rosso); }
  .feature-grid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px;
    align-items: end;
  }
  .feature-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.08;
    color: var(--ink);
    text-wrap: balance;
    transition: color 0.2s ease;
  }
  .feature:hover .feature-title, .item:hover .item-title { color: var(--rosso); }
  .feature-excerpt { font-size: 17px; line-height: 1.6; color: var(--ink-soft); }

  .meta { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12px; color: var(--stone); }
  .read {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .read :global(svg) { transition: transform 0.25s var(--ease); }
  .feature:hover .read :global(svg), .item:hover .read :global(svg) { transform: translateX(3px); }

  .list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 56px; }
  .item { display: block; padding: 36px 0 40px; border-bottom: 1px solid var(--bone); height: 100%; }
  .item .meta { margin-top: 0; }
  .item-title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 1.15;
    color: var(--ink);
    text-wrap: balance;
    transition: color 0.2s ease;
  }
  .item-excerpt {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1023px) {
    .feature-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
  @media (max-width: 767px) {
    .list { grid-template-columns: minmax(0, 1fr); }
    .feature { padding-top: 8px; }
  }
</style>
