---
/**
 * 04 — For hotels. What an independent hotel gets for the one price: its
 * booking engine on the site, every language, changes within 24 hours, and a
 * contact based in Lugano. Facts only, all taken from the offer itself.
 */
import Icon from '@components/Icon.astro';
import { em, href, type Lang } from '@/i18n';
import { home } from '@/i18n/home';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = home[lang].hotels;
---
<section id="hotels" class="section section--paper section--rule hotels" aria-labelledby="hotels-title">
  <div class="container">
    <div class="sec-head">
      <span class="secnum reveal">{t.num}</span>
      <h2 id="hotels-title" class="d2 reveal" style="--d:0.05s" set:html={em(t.title)} />
      <p class="lede reveal" style="--d:0.1s">{t.lede}</p>
    </div>

    <ul class="hotels-grid">
      {t.items.map((item, i) => (
        <li class="hotels-item reveal" style={`--d:${i * 0.08}s`}>
          <span class="hotels-plus" aria-hidden="true">+</span>
          <h3 class="hotels-t">{item.t}</h3>
          <p class="hotels-d">{item.d}</p>
        </li>
      ))}
    </ul>

    <div class="hotels-foot reveal">
      <p class="body">{t.note}</p>
      <a href={href(lang, 'pricing')} class="arrow-link">{t.link}<Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .hotels-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }
  .hotels-item {
    padding-top: 22px;
    border-top: 1px solid var(--bone);
  }
  .hotels-plus { display: block; font-family: var(--font-mono); font-weight: 500; line-height: 1.5; color: var(--rosso); }
  .hotels-t {
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1.2;
    color: var(--ink);
  }
  .hotels-d { margin-top: 12px; font-size: 15.5px; line-height: 1.6; color: var(--ink-soft); }

  .hotels-foot {
    margin-top: 56px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    flex-wrap: wrap;
  }
  .hotels-foot .body { color: var(--stone); max-width: 60ch; }

  @media (max-width: 1023px) {
    .hotels-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
  }
  @media (max-width: 599px) {
    .hotels-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
</style>
