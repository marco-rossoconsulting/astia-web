---
import { getEntry } from 'astro:content';
import ProblemCards from '@components/ProblemCards.astro';
import PriceTeaserCard from '@components/PriceTeaserCard.astro';
import Hero24 from '@components/Hero24.astro';
import ComparisonSection from '@components/ComparisonSection.astro';
import HowItWorksSteps from '@components/HowItWorksSteps.astro';

interface Props {
  lang: 'en' | 'de' | 'it';
}
const { lang } = Astro.props;

const home = await getEntry('pages', 'home');
const site = await getEntry('site', 'general');

const d = home.data as any;
const s = site.data as any;
const cta = s.cta;
const perMonth = lang === 'en' ? '/mo' : (lang === 'de' ? '/Mt.' : '/mese');

const url = (p: string) => {
  const prefix = lang === 'en' ? '' : `/${lang}`;
  const paths: Record<string, string> = { how: '/how-it-works', pricing: '/pricing', apply: '/apply', showcase: '/showcase' };
  return prefix + paths[p];
};

const selfPrices = [
  { rooms: d.pricingTeaser.rooms.upTo15[lang], price: d.pricingTeaser.selfPrices.upTo15 },
  { rooms: d.pricingTeaser.rooms.upTo30[lang], price: d.pricingTeaser.selfPrices.upTo30 },
  { rooms: d.pricingTeaser.rooms.plus50[lang], price: d.pricingTeaser.selfPrices.plus50 },
];
const managedPrices = [
  { rooms: d.pricingTeaser.rooms.upTo15[lang], price: d.pricingTeaser.managedPrices.upTo15 },
  { rooms: d.pricingTeaser.rooms.upTo30[lang], price: d.pricingTeaser.managedPrices.upTo30 },
  { rooms: d.pricingTeaser.rooms.plus50[lang], price: d.pricingTeaser.managedPrices.plus50 },
];

const hiwSteps = d.steps.items.map((s: any) => ({
  num: s.num,
  title: s.title[lang],
  days: s.days[lang],
  body: s.body[lang],
  kind: s.kind,
  vignetteLabel: s.vignette.label[lang],
  vignetteHeader: s.vignette.header[lang],
  vignetteBadge: s.vignette.badge[lang],
  vignetteRows: s.vignette.rows.map((r: any) => ({
    title: r.title[lang],
    meta: r.meta[lang],
    active: !!r.active,
  })),
  details: (s.details || []).map((detail: any) => ({
    n: detail.n,
    label: detail.label[lang],
    days: detail.days ? detail.days[lang] : '',
  })),
}));
---

{/* ===== HERO 24 ===== */}
<Hero24
  chipText={lang === 'en' ? "Astia Web AI-managed sites" : lang === 'de' ? "Astia Web AI-verwaltete Sites" : "Astia Web Siti gestiti dall'IA"}
  headlinePre={d.hero.preEm[lang]}
  headlineEm={d.hero.em[lang]}
  headlinePost={" " + d.hero.post[lang]}
  subheadline={d.hero.lede[lang]}
  badgeText={d.hero.badge[lang]}
  primaryCta={cta.applyForSite[lang]}
  primaryCtaHref={url('apply')}
  secondaryCta={cta.seeHow[lang]}
  secondaryCtaHref={url('how')}
/>

<hr class="section-divider" />

{/* ===== PROBLEM CARDS ===== */}
<ProblemCards
  headline={d.problem.h2pre[lang]}
  headlineEm={d.problem.h2em[lang]}
  subheadline={d.problem.intro[lang]}
  cards={d.problem.cards.map((c: any) => ({
    tag: c.tag[lang],
    title: c.title[lang],
    body: c.body[lang],
    tail: c.tail[lang],
  }))}
/>

<hr class="section-divider" />

{/* ===== SOLUTION ===== */}
<section class="section section-cream">
  <div class="container-narrow">
    <h2 class="display-2 reveal" style="margin-bottom:32px;">
      {d.solution.h2pre[lang]} <span class="editorial-i">{d.solution.h2em[lang]}</span>
    </h2>
    <p class="lede reveal">{d.solution.p1[lang]}</p>
    <p class="lede reveal">
      {d.solution.p2pre[lang]} <span class="editorial-i text-rosso">{d.solution.p2em[lang]}</span>
    </p>

    <blockquote class="pulled-quote reveal">
      {d.solution.quoteL1[lang]}<br />
      {d.solution.quoteL2[lang]}<br />
      <span style="color:var(--rosso);">{d.solution.quoteL3[lang]}</span>
    </blockquote>

    <p class="body reveal" style="color:var(--stone);">{d.solution.p3[lang]}</p>
  </div>
</section>

<hr class="section-divider" />

{/* ===== STEPS — How It Works 8–inspired ===== */}
<HowItWorksSteps
  headlinePre={d.steps.h2pre[lang]}
  headlineEm={d.steps.h2em[lang]}
  lede={d.steps.lede[lang]}
  steps={hiwSteps}
  ctaLabel={d.steps.ctaFull[lang]}
  ctaHref={url('how')}
/>

<hr class="section-divider" />

{/* ===== COMPARISON 8 ===== */}
<ComparisonSection
  headline={d.comparison.h2pre[lang] + " " + d.comparison.h2em[lang]}
  subheadline={d.comparison.intro[lang]}
/>

<hr class="section-divider" />

{/* ===== PRICING ===== */}
<section class="section section-cream">
  <div class="container">
    <h2 class="display-2 reveal" style="margin-bottom:12px;">
      {d.pricingTeaser.h2pre[lang]} <span class="editorial-i">{d.pricingTeaser.h2em[lang]}</span>
    </h2>
    <p class="body reveal" style="max-width:580px; margin-bottom:48px;">{d.pricingTeaser.intro[lang]}</p>

    <div class="grid-2 reveal">
      <PriceTeaserCard
        tier={d.pricingTeaser.selfTier.tier[lang]}
        tagline={d.pricingTeaser.selfTier.tagline[lang]}
        roomsLabel={d.pricingTeaser.roomsLabel[lang]}
        prices={selfPrices}
        perMonth={perMonth}
      />
      <PriceTeaserCard
        tier={d.pricingTeaser.managedTier.tier[lang]}
        tagline={d.pricingTeaser.managedTier.tagline[lang]}
        roomsLabel={d.pricingTeaser.roomsLabel[lang]}
        prices={managedPrices}
        recommended
        recommendedLabel={d.pricingTeaser.recommended[lang]}
        perMonth={perMonth}
      />
    </div>

    <div class="reveal" style="margin-top:36px;">
      <a class="btn btn-ghost btn-arrow" href={url('pricing')}>{d.pricingTeaser.cta[lang]}</a>
    </div>
  </div>
</section>

<hr class="section-divider" />

{/* ===== FAQ ===== */}
<section class="section section-cream">
  <div class="container-narrow">
    <h2 class="display-2 reveal" style="margin-top:0; margin-bottom:48px;">
      {d.faq.h2pre[lang]} <span class="editorial-i">{d.faq.h2em[lang]}</span>
    </h2>

    <div class="faq-list reveal">
      {d.faq.items.map((item: any, i: number) => (
        <div class="faq-item">
          <button
            class="faq-q-btn"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
            data-faq-index={i}
          >
            <span>{item.q[lang]}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-a-wrap" id={`faq-answer-${i}`}>
            <p class="faq-a">{item.a[lang]}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<hr class="section-divider" />

{/* ===== FINAL CTA ===== */}
<section class="section">
  <div class="container-narrow reveal" style="text-align:center;">
    <h2 class="display-2" style="margin-top:0; margin-bottom:28px;">
      {d.finalCTA.h2pre[lang]} <span class="editorial-i">{d.finalCTA.h2em[lang]}</span> {d.finalCTA.h2post[lang]}
    </h2>
    <p class="lede" style="margin-bottom:40px; max-width:540px; margin-left:auto; margin-right:auto;">{d.finalCTA.lede[lang]}</p>
    <a class="btn btn-primary btn-arrow" href={url('apply')}>{cta.applyForSite[lang]}</a>
  </div>
</section>

{/* FAQ Accordion Script */}
<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('.faq-q-btn');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var index = btn.getAttribute('data-faq-index');
        var wrap = document.getElementById('faq-answer-' + index);
        buttons.forEach(function (b) {
          if (b !== btn) {
            b.setAttribute('aria-expanded', 'false');
            var otherIndex = b.getAttribute('data-faq-index');
            var otherWrap = document.getElementById('faq-answer-' + otherIndex);
            if (otherWrap) otherWrap.classList.remove('open');
          }
        });
        btn.setAttribute('aria-expanded', String(!expanded));
        if (wrap) wrap.classList.toggle('open');
      });
    });
  })();
</script>
