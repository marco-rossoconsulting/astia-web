---
import { getEntry } from 'astro:content';
import SpecCard from '@components/SpecCard.astro';
import MathCard from '@components/MathCard.astro';
import IncludedFeatures from '@components/IncludedFeatures.tsx';
import HowItWorksHero from '@components/HowItWorksHero.tsx';

interface Props { lang: 'en' | 'de' | 'it'; }
const { lang } = Astro.props;

const how = await getEntry('pages', 'how');
const site = await getEntry('site', 'general');
const d = how.data as any;
const cta = (site.data as any).cta;

const url = (p: string) => (lang === 'en' ? '' : `/${lang}`) + ({ apply: '/apply', pricing: '/pricing' } as any)[p];

const includedFeatures = (d.included.features || []).map((f: any) => ({
  icon: f.icon,
  title: f.title[lang],
  description: f.description[lang],
}));
---
{/* HERO */}
<HowItWorksHero
  client:load
  eyebrow={d.hero.eyebrow?.[lang]}
  headlinePre={d.hero.headlinePre[lang]}
  headlineEm={d.hero.headlineEm[lang]}
  headlinePost={d.hero.headlinePost[lang]}
  lede={d.hero.lede[lang]}
/>

<hr class="rule" />

{/* TECHNICAL CASE */}
<section class="section">
  <div class="container">
    <h2 class="display-2 reveal" style="margin-bottom:12px;">
      {d.technical.h2pre[lang]} <span class="editorial-i">{d.technical.h2em[lang]}</span>
    </h2>
    <p class="body reveal" style="max-width:720px; margin-bottom:48px;">{d.technical.intro[lang]}</p>

    <div class="grid-4">
      {d.technical.specs.map((spec: any, i: number) => (
        <div class={`reveal reveal-delay-${i + 1}`}>
          <SpecCard
            label={spec.label[lang]}
            us={typeof spec.us === 'string' ? spec.us : spec.us[lang]}
            them={spec.them[lang]}
          />
        </div>
      ))}
    </div>

    <p class="body-sm reveal" style="max-width:720px; margin-top:24px; color:var(--stone);">{d.technical.caveat[lang]}</p>
  </div>
</section>

<hr class="rule" />

{/* WHAT'S INCLUDED */}
<IncludedFeatures
  client:visible
  headlinePre={d.included.h2pre[lang]}
  headlineEm={d.included.h2em[lang]}
  features={includedFeatures}
/>

<hr class="rule" />

{/* BOOKING MATH */}
<section class="section section-cream">
  <div class="container">
    <h2 class="display-2 reveal" style="margin-bottom:48px;">
      {d.bookingMath.h2pre[lang]} <span class="editorial-i">{d.bookingMath.h2em[lang]}</span>
    </h2>

    <div class="reveal">
      <MathCard
        stat={d.bookingMath.stat}
        statLabel={d.bookingMath.statLabel[lang]}
        vs={d.bookingMath.vs[lang]}
        body={d.bookingMath.body[lang]}
      />
    </div>
  </div>
</section>

<hr class="rule" />

{/* ABOUT */}
<section class="section">
  <div class="container-narrow">
    <h2 class="display-2 reveal" style="margin-bottom:24px;">
      {d.about.h2pre[lang]} <span class="editorial-i">{d.about.h2em[lang]}</span>
    </h2>
    <p class="lede reveal" style="margin-bottom:40px;">{d.about.body[lang]}</p>

    <div class="reveal" style="display:flex; flex-direction:column; align-items:center; gap:32px; margin-top:8px;">
      {d.about.logoSrc && (
        <img
          src={d.about.logoSrc}
          alt={d.about.logoAlt?.[lang] || 'Marcorosso Consulting'}
          style="max-height:48px; width:auto; opacity:0.85;"
        />
      )}
      <a
        class="btn btn-primary btn-arrow"
        href={d.about.ctaHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {d.about.ctaLabel[lang]}
      </a>
    </div>
  </div>
</section>

<hr class="rule" />

{/* FINAL CTA */}
<section class="section">
  <div class="container-narrow reveal" style="text-align:center;">
    <h2 class="display-2" style="margin-bottom:28px;">
      {d.finalCTA.h2pre[lang]} <span class="editorial-i">{d.finalCTA.h2em[lang]}</span>
    </h2>
    <p class="lede" style="margin-bottom:40px; max-width:540px; margin-left:auto; margin-right:auto;">{d.finalCTA.lede[lang]}</p>
    <a class="btn btn-primary btn-arrow" href={url('apply')}>{cta.applyForSite[lang]}</a>
  </div>
</section>
