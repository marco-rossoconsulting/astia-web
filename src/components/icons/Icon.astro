---
/**
 * Inline Lucide icons, rendered as static SVG at build time.
 * Replaces the lucide-react dependency in .astro components so icons cost
 * zero JavaScript. Paths are copied verbatim from lucide-react's icon nodes.
 */
interface Props {
  /** Lucide icon name, e.g. 'inbox', 'shield-check'. See PATHS below. */
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 16, strokeWidth = 2, class: className } = Astro.props;

