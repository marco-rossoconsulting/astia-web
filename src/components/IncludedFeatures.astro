---
import Icon from '@components/icons/Icon.astro';

export interface IncludedFeature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  headlinePre: string;
  headlineEm: string;
  lede?: string;
  features: IncludedFeature[];
}

const { headlinePre, headlineEm, lede, features } = Astro.props;

/** Maps the icon names used in content JSON to the inline Lucide set. */
const ICONS: Record<string, string> = {
  Globe: 'globe',
  Shield: 'shield',
  ShieldCheck: 'shield-check',
  Lock: 'lock',
  Database: 'database',
  ClipboardCheck: 'clipboard-check',
  Languages: 'languages',
  Mail: 'mail',
  Bot: 'bot',
  Users: 'users',
  GitBranch: 'git-branch',
  Server: 'server',
};
---
<section class="section inc-section" aria-labelledby="inc-heading">
  <div class="container inc-inner">
    <header class="inc-header reveal">
      <h2 id="inc-heading" class="display-2">
        {headlinePre} <span class="editorial-i">{headlineEm}</span>
      </h2>
      {lede && <p class="lede">{lede}</p>}
    </header>

    <div class="inc-grid">
      {features.map((feature, i) => (
        <article class={`inc-item reveal reveal-delay-${(i % 3) + 1}`}>
          <div class="inc-item-head">
            <span class="inc-icon-well" aria-hidden="true">
              <Icon name={ICONS[feature.icon] ?? 'server'} size={20} strokeWidth={1.75} />
            </span>
            <h3 class="inc-title">{feature.title}</h3>
          </div>
          <p class="inc-desc">{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .inc-header {
    text-align: left;
    max-width: 720px;
    margin: 0 0 56px;
  }
  .inc-header .display-2 { margin-bottom: 0; }
  .inc-header .lede { margin-top: 16px; margin-bottom: 0; }
  .inc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .inc-item { min-width: 0; }
  .inc-item-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .inc-icon-well {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream, #FAFAF7);
    border: 1px solid var(--bone, #E5E2DA);
    box-shadow: var(--shadow-soft, 0 1px 3px rgba(20,20,20,0.04), 0 8px 24px rgba(20,20,20,0.04));
    color: var(--rosso, #C41E3A);
    border-radius: 0;
  }
  .inc-title {
    font-family: 'General Sans', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink, #141414);
    margin: 0;
  }
  .inc-desc {
    font-family: 'General Sans', sans-serif;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft, #2A2A2A);
    margin: 0;
  }
  @media (min-width: 640px) {
    .inc-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 36px;
    }
  }
  @media (min-width: 1024px) {
    .inc-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 48px 40px;
    }
  }
  @media (max-width: 880px) {
    .inc-header { margin-bottom: 40px; }
  }
</style>
