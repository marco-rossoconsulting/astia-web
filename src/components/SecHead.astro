---
import { em } from '@/i18n';
interface Props {
  num?: string;
  title: string;
  lede?: string;
  center?: boolean;
  as?: 'h1' | 'h2';
  size?: 'd1' | 'd2';
  id?: string;
  class?: string;
}
const { num, title, lede, center = false, as: Tag = 'h2', size = 'd2', id, class: className } = Astro.props;
---
<div class:list={['sec-head', { 'sec-head--center': center }, className]}>
  {num && <span class="secnum reveal">{num}</span>}
  <Tag id={id} class:list={[size, 'reveal']} style="--d:0.05s" set:html={em(title)} />
  {lede && <p class="lede reveal" style="--d:0.1s">{lede}</p>}
  <slot />
</div>
