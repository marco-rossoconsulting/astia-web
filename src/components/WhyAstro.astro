---
import Icon from '@components/icons/Icon.astro';

export interface StackNode {
  icon: string;
  label: string;
  note: string;
}

export interface Spec {
  label: string;
  us: string;
  them: string;
}

interface Props {
  eyebrow: string;
  headlinePre: string;
  headlineEm: string;
  intro: string;
  caveat: string;
  hubLabel: string;
  hubNote: string;
  nodes: StackNode[];
  specs: Spec[];
}

const {
  eyebrow,
  headlinePre,
  headlineEm,
  intro,
  caveat,
  hubLabel,
  hubNote,
  nodes,
  specs,
} = Astro.props;

/**
 * Six nodes on a circle, starting at the top and going clockwise.
 * Percentages are positions inside the square diagram box, and the same
 * coordinates drive both the SVG spokes and the absolutely-placed cards.
 */
const RADIUS = 38;
const positions = nodes.map((_, i) => {
  const angle = (Math.PI * 2 * i) / nodes.length - Math.PI / 2;
  return {
    x: 50 + RADIUS * Math.cos(angle),
    y: 50 + RADIUS * Math.sin(angle),
  };
});

/** Small static specks scattered outside the ring, for depth. */
const scatter = [
  { cx: 27, cy: 15, r: 0.55 },
  { cx: 71, cy: 9, r: 0.4 },
  { cx: 93, cy: 50, r: 0.5 },
  { cx: 87, cy: 87, r: 0.4 },
  { cx: 13, cy: 88, r: 0.5 },
  { cx: 7, cy: 49, r: 0.4 },
  { cx: 35, cy: 96, r: 0.4 },
  { cx: 64, cy: 4, r: 0.45 },
];
---
<section class="why-astro" aria-labelledby="why-astro-heading">
  <div class="why-astro-inner">
    <div class="why-astro-split">
      {/* ---------- Copy ---------- */}
      <div class="why-astro-copy reveal">
        <span class="why-astro-eyebrow">{eyebrow}</span>

        <h2 id="why-astro-heading" class="why-astro-h2">
          {headlinePre}<span class="editorial-i">{headlineEm}</span>
        </h2>

        <p class="why-astro-intro">{intro}</p>
      </div>

      {/* ---------- Orbital diagram ---------- */}
      <div
        class="why-astro-diagram reveal"
        role="img"
        aria-label={`${hubLabel}: ${nodes.map((n) => n.label).join(', ')}`}
      >
        <div class="why-astro-orbit">
          <div aria-hidden="true" class="why-astro-glow"></div>

          <svg viewBox="0 0 100 100" class="why-astro-svg" aria-hidden="true">
            {scatter.map((dot) => (
              <circle cx={dot.cx} cy={dot.cy} r={dot.r} class="wa-speck" />
            ))}

            {/* Outer ring */}
            <circle cx="50" cy="50" r="38" fill="none" vector-effect="non-scaling-stroke" class="wa-ring" />

            {/* Inner dashed ring, slowly rotating */}
            <g class="wa-ring-spin">
              <circle
                cx="50"
                cy="50"
                r="25"
                fill="none"
                vector-effect="non-scaling-stroke"
                stroke-dasharray="0.4 2.6"
                stroke-linecap="round"
                class="wa-ring-dashed"
              />
            </g>

            {/* Spokes from the hub out to each node */}
            {positions.map((p, i) => (
              <line
                x1="50"
                y1="50"
                x2={p.x}
                y2={p.y}
                vector-effect="non-scaling-stroke"
                stroke-linecap="round"
                class={`wa-spoke wa-spoke-${i + 1}`}
              />
            ))}

            {/* A signal running down each spoke, from the node into the hub */}
            {positions.map((p, i) => (
              <line
                x1={p.x}
                y1={p.y}
                x2="50"
                y2="50"
                stroke-linecap="round"
                class={`wa-signal wa-signal-${i + 1}`}
              />
            ))}
          </svg>

          {/* Hub */}
          <div class="why-astro-hub">
            <div class="why-astro-hub-tile">
              <span aria-hidden="true" class="why-astro-hub-pulse"></span>
              <Icon name="boxes" size={34} strokeWidth={1.35} />
            </div>
            <span class="why-astro-hub-label">{hubLabel}</span>
            <span class="why-astro-hub-note">{hubNote}</span>
          </div>

          {/* Nodes */}
          {nodes.map((node, i) => (
            <div
              class={`why-astro-node why-astro-node-${i + 1}`}
              style={`left:${positions[i].x}%; top:${positions[i].y}%`}
            >
              <div class="why-astro-node-float">
                <span class="why-astro-node-tile">
                  <Icon name={node.icon} size={22} strokeWidth={1.5} />
                </span>
                <span class="why-astro-node-label">{node.label}</span>
                <span class="why-astro-node-note">{node.note}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* ---------- Figures ---------- */}
    <div class="why-astro-specs">
      {specs.map((spec, i) => (
        <div class={`why-astro-spec reveal reveal-delay-${(i % 3) + 1}`}>
          <span class="why-astro-spec-label">{spec.label}</span>
          <span class="why-astro-spec-us">{spec.us}</span>
          <span class="why-astro-spec-them">{spec.them}</span>
        </div>
      ))}
    </div>

    <p class="why-astro-caveat reveal">{caveat}</p>
  </div>
</section>

<style is:global>
  .why-astro {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--ink, #141414);
    color: var(--paper, #F7F5F0);
    padding: 104px 0;
  }
  /* Warm bloom so the flat ink reads as lit, not as a black slab. */
  .why-astro::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 60% at 74% 34%, rgba(196, 30, 58, 0.16) 0%, rgba(196, 30, 58, 0) 68%),
      radial-gradient(ellipse 60% 50% at 12% 8%, rgba(247, 245, 240, 0.05) 0%, rgba(247, 245, 240, 0) 60%);
  }
  .why-astro-inner {
    position: relative;
    max-width: var(--container-max, 1240px);
    margin: 0 auto;
    padding: 0 32px;
  }
  .why-astro-split {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    align-items: center;
    gap: 64px;
  }

  /* ---------- Copy ---------- */
  .why-astro-eyebrow {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rosso, #C41E3A);
    margin-bottom: 18px;
  }
  .why-astro-h2 {
    font-family: 'Editorial New', Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--paper, #F7F5F0);
    margin: 0 0 22px;
  }
  .why-astro-intro {
    font-family: 'General Sans', -apple-system, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(247, 245, 240, 0.72);
    margin: 0;
    max-width: 520px;
  }

  /* ---------- Diagram ---------- */
  .why-astro-diagram { display: flex; justify-content: center; }
  .why-astro-orbit {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1 / 1;
  }
  .why-astro-glow {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(196, 30, 58, 0.12) 0%, rgba(196, 30, 58, 0) 62%);
  }
  .why-astro-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .wa-speck { fill: rgba(247, 245, 240, 0.28); }
  .wa-ring { stroke: rgba(247, 245, 240, 0.2); stroke-width: 1; }
  .wa-ring-dashed { stroke: rgba(247, 245, 240, 0.34); stroke-width: 1; }
  .wa-ring-spin { transform-origin: 50% 50%; animation: waSpin 90s linear infinite; }
  @keyframes waSpin { to { transform: rotate(360deg); } }

  /* Spokes are drawn by default, and only hidden-then-drawn when the reveal
     observer is available — so they never stay missing without scripting. */
  .wa-spoke {
    stroke: rgba(247, 245, 240, 0.26);
    stroke-width: 1.1;
  }
  .js .wa-spoke {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
  }
  .js .why-astro-diagram.visible .wa-spoke {
    animation: waDraw 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes waDraw { to { stroke-dashoffset: 0; } }

  /* Signal dots. Stroke units are viewBox units here (no non-scaling-stroke),
     so the dash travels the spoke's full 38-unit length. */
  .wa-signal {
    stroke: var(--rosso, #C41E3A);
    stroke-width: 0.7;
    stroke-dasharray: 1.6 100;
    stroke-dashoffset: -38;
    opacity: 0;
  }
  .js .why-astro-diagram.visible .wa-signal {
    animation: waSignal 3.4s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  @keyframes waSignal {
    0%        { stroke-dashoffset: -38; opacity: 0; }
    12%       { opacity: 0.95; }
    82%       { opacity: 0.95; }
    100%      { stroke-dashoffset: 0; opacity: 0; }
  }
  .wa-signal-1 { animation-delay: 0s; }
  .wa-signal-2 { animation-delay: 0.55s; }
  .wa-signal-3 { animation-delay: 1.1s; }
  .wa-signal-4 { animation-delay: 1.65s; }
  .wa-signal-5 { animation-delay: 2.2s; }
  .wa-signal-6 { animation-delay: 2.75s; }
  .wa-spoke-1 { animation-delay: 0.10s; }
  .wa-spoke-2 { animation-delay: 0.18s; }
  .wa-spoke-3 { animation-delay: 0.26s; }
  .wa-spoke-4 { animation-delay: 0.34s; }
  .wa-spoke-5 { animation-delay: 0.42s; }
  .wa-spoke-6 { animation-delay: 0.50s; }

  /* ---------- Hub ---------- */
  .why-astro-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .why-astro-hub-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    background: var(--paper, #F7F5F0);
    color: var(--rosso, #C41E3A);
    border: 1px solid rgba(247, 245, 240, 0.9);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
  }
  .why-astro-hub-pulse {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--rosso, #C41E3A);
    animation: waPulse 3.4s ease-in-out infinite;
  }
  @keyframes waPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50%      { transform: scale(1.18); opacity: 0; }
  }
  .why-astro-hub-label {
    margin-top: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--paper, #F7F5F0);
  }
  .why-astro-hub-note {
    margin-top: 5px;
    font-family: 'General Sans', sans-serif;
    font-size: 11px;
    line-height: 1.4;
    color: rgba(247, 245, 240, 0.45);
    max-width: 150px;
  }

  /* ---------- Nodes ---------- */
  .why-astro-node {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .why-astro-node-float {
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: waFloat 5s ease-in-out infinite;
  }
  @keyframes waFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-6px); }
  }
  .why-astro-node-2 .why-astro-node-float { animation-duration: 5.6s; animation-delay: -0.7s; }
  .why-astro-node-3 .why-astro-node-float { animation-duration: 4.6s; animation-delay: -1.4s; }
  .why-astro-node-4 .why-astro-node-float { animation-duration: 5.9s; animation-delay: -2.1s; }
  .why-astro-node-5 .why-astro-node-float { animation-duration: 5.2s; animation-delay: -2.8s; }
  .why-astro-node-6 .why-astro-node-float { animation-duration: 4.9s; animation-delay: -3.5s; }

  .why-astro-node-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: #1D1D1D;
    border: 1px solid rgba(247, 245, 240, 0.16);
    color: var(--paper, #F7F5F0);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.4);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .why-astro-node:hover .why-astro-node-tile {
    border-color: var(--rosso, #C41E3A);
    color: var(--rosso, #C41E3A);
    transform: translateY(-3px);
  }
  .why-astro-node-label {
    margin-top: 10px;
    font-family: 'General Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--paper, #F7F5F0);
    white-space: nowrap;
  }
  .why-astro-node-note {
    margin-top: 2px;
    font-family: 'General Sans', sans-serif;
    font-size: 11px;
    line-height: 1.35;
    color: rgba(247, 245, 240, 0.5);
    white-space: nowrap;
  }

  /* ---------- Figures ---------- */
  .why-astro-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 88px;
    border-top: 1px solid rgba(247, 245, 240, 0.14);
  }
  .why-astro-spec {
    display: flex;
    flex-direction: column;
    padding: 28px 28px 26px 0;
    border-right: 1px solid rgba(247, 245, 240, 0.14);
  }
  .why-astro-spec:last-child { border-right: 0; }
  .why-astro-spec:not(:first-child) { padding-left: 28px; }
  .why-astro-spec-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(247, 245, 240, 0.45);
    margin-bottom: 14px;
  }
  .why-astro-spec-us {
    font-family: 'Editorial New', Georgia, serif;
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1;
    color: var(--paper, #F7F5F0);
    margin-bottom: 12px;
  }
  .why-astro-spec-them {
    font-family: 'General Sans', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(247, 245, 240, 0.42);
  }
  .why-astro-caveat {
    margin: 28px 0 0;
    max-width: 720px;
    font-family: 'General Sans', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(247, 245, 240, 0.38);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1080px) {
    .why-astro-split { gap: 44px; }
    .why-astro-node-note { display: none; }
  }
  @media (max-width: 900px) {
    .why-astro { padding: 72px 0; }
    .why-astro-inner { padding: 0 24px; }
    .why-astro-split { grid-template-columns: 1fr; gap: 52px; }
    .why-astro-orbit { max-width: 420px; }
    .why-astro-specs { grid-template-columns: repeat(2, 1fr); margin-top: 56px; }
    .why-astro-spec { padding: 24px 20px 22px 0; }
    .why-astro-spec:nth-child(2n) { border-right: 0; padding-left: 20px; }
    .why-astro-spec:nth-child(n + 3) { border-top: 1px solid rgba(247, 245, 240, 0.14); }
    .why-astro-spec:nth-child(odd) { padding-left: 0; }
  }
  @media (max-width: 520px) {
    .why-astro-orbit { max-width: 320px; }
    .why-astro-hub-tile { width: 84px; height: 84px; }
    .why-astro-node-tile { width: 46px; height: 46px; }
    .why-astro-node-label { font-size: 11px; }
    .why-astro-hub-note { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-ring-spin,
    .why-astro-hub-pulse,
    .why-astro-node-float,
    .wa-signal { animation: none !important; }
    .wa-signal { opacity: 0 !important; }
    .wa-spoke { stroke-dashoffset: 0 !important; animation: none !important; }
    .why-astro-node:hover .why-astro-node-tile { transform: none; }
  }
</style>
